<mxfile host="app.diagrams.net">
  <diagram id="dds-logical" name="DDS Logical Star Schema">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="fact" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;FactYellowTaxiTrip&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Grain: 1 dòng = 1 bản ghi nguồn (không phải chuyến duy nhất)&lt;/i&gt;&lt;br&gt;PK TripRecordKey (surrogate)&lt;br&gt;DD SourceFileMonth, SourceRowNumber (đề xuất OD-13)&lt;br&gt;FK PickupDateKey&lt;br&gt;FK PickupTimeKey&lt;br&gt;FK DropoffDateKey&lt;br&gt;FK DropoffTimeKey&lt;br&gt;FK PickupTaxiZoneKey&lt;br&gt;FK DropoffTaxiZoneKey&lt;br&gt;FK VendorKey&lt;br&gt;FK RateCodeKey&lt;br&gt;FK PaymentTypeKey&lt;br&gt;FK PassengerGroupKey&lt;br&gt;FK DistanceBandKey&lt;br&gt;DD PickupDateTime, DropoffDateTime, StoreAndForwardFlag&lt;br&gt;&lt;b&gt;Measures (raw)&lt;/b&gt;&lt;br&gt;TripRecordCount, PassengerCount, TripDistanceMiles&lt;br&gt;FareAmount, ExtraAmount, MtaTaxAmount, TipAmount&lt;br&gt;TollsAmount, ImprovementSurchargeAmount&lt;br&gt;CongestionSurchargeAmount, AirportFeeAmount, TotalAmount&lt;br&gt;&lt;b&gt;Derived&lt;/b&gt;&lt;br&gt;TripDurationSeconds, ExtraResidualAmount (OD-02)&lt;br&gt;IsValidDuration, IsValidForSpeed (OD-07), IsValidForTipRatio&lt;br&gt;IsNegativeTotalAmount, IsInStudyPeriod&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="330" height="442" as="geometry"/></mxCell>
        <mxCell id="date" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;DimDate&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PK DateKey (YYYYMMDD, -1)&lt;br&gt;FullDate, DayOfMonth&lt;br&gt;DayOfWeekNumber, DayOfWeekName, IsWeekend&lt;br&gt;MonthNumber, MonthName, YearMonth&lt;br&gt;Quarter, Year, DaysInMonth&lt;br&gt;IsUSFederalHoliday, HolidayName, IsInStudyPeriod&lt;br&gt;&lt;i&gt;Year → Quarter → Month → Day&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="270" height="153" as="geometry"/></mxCell>
        <mxCell id="time" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;DimTime&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PK TimeKey (HHMM)&lt;br&gt;Hour24, Minute, HourLabel&lt;br&gt;DaypartCode, DaypartName, DaypartSortOrder (chờ OD-08)&lt;br&gt;IsPeakSurchargeWindow, IsOvernightSurchargeWindow&lt;br&gt;&lt;i&gt;Daypart → Hour → Minute&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="270" height="119" as="geometry"/></mxCell>
        <mxCell id="zone" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;DimTaxiZone&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PK TaxiZoneKey (-1 = thiếu mã, khác ID 264)&lt;br&gt;BK LocationID (1–265)&lt;br&gt;Borough, Zone, ServiceZone&lt;br&gt;HasGeometry (FALSE cho 264, 265)&lt;br&gt;&lt;i&gt;Borough → Zone → LocationID&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="270" height="119" as="geometry"/></mxCell>
        <mxCell id="vendor" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;DimVendor&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PK VendorKey&lt;br&gt;BK VendorID (mã gốc; 5, 6 chờ OD-04)&lt;br&gt;VendorName, VendorShortName&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1120" y="40" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="rate" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;DimRateCode&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PK RateCodeKey&lt;br&gt;BK RatecodeID (1–6, 99 riêng; NULL → -1)&lt;br&gt;RateDescription, RateCategory, IsFlatFare&lt;br&gt;&lt;i&gt;RateCategory → RateDescription&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1120" y="190" width="250" height="102" as="geometry"/></mxCell>
        <mxCell id="pay" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;DimPaymentType&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PK PaymentTypeKey&lt;br&gt;BK PaymentTypeID (1–6; mã 0 chờ OD-03)&lt;br&gt;PaymentDescription, PaymentGroup&lt;br&gt;AllowsElectronicTip&lt;br&gt;&lt;i&gt;PaymentGroup → PaymentDescription&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1120" y="360" width="250" height="119" as="geometry"/></mxCell>
        <mxCell id="pax" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;DimPassengerGroup&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PK PassengerGroupKey (= giá trị; -1 = NULL)&lt;br&gt;PassengerCountValue (NULL, 0–9, ≥10)&lt;br&gt;GroupCode, GroupName, GroupSortOrder&lt;br&gt;IsReportedCount&lt;br&gt;&lt;i&gt;Group → PassengerCountValue&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1120" y="540" width="250" height="119" as="geometry"/></mxCell>
        <mxCell id="dist" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;DimDistanceBand&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PK DistanceBandKey (1–5; -1 = NULL/âm)&lt;br&gt;BandCode, BandName&lt;br&gt;LowerBoundMiles, UpperBoundMiles, SortOrder&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1120" y="720" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="e0" value="Pickup Date" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="date" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="Drop-off Date" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="date" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Pickup Time" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="time" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Drop-off Time" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.38;entryDx=0;entryDy=0;" edge="1" parent="1" source="time" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Pickup Zone" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="zone" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Drop-off Zone" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.58;entryDx=0;entryDy=0;" edge="1" parent="1" source="zone" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Vendor" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="vendor" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Rate Code" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="rate" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Payment Type" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.38;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Passenger Group" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.52;entryDx=0;entryDy=0;" edge="1" parent="1" source="pax" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Distance Band" style="rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="dist" target="fact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;NYC Yellow Taxi DDS – Logical Star Schema (Phase 1)&lt;/b&gt;&lt;br&gt;Đồng tác giả: Lộc (grain, Fact, vai trò, Date/Time, nhóm) · Dũng (Zone, Vendor, RateCode, PaymentType)&lt;br&gt;Dữ liệu: 24 tệp Yellow Taxi 01/2022–12/2023 (77.966.324 bản ghi)&lt;br&gt;Vàng = chiều tham chiếu nguồn (Dũng) · Xanh lá = chiều hỗ trợ (Lộc) · Xanh dương = Fact&lt;br&gt;Tuyến (C7) = cặp có thứ tự (PickupTaxiZoneKey, DropoffTaxiZoneKey), A→B ≠ B→A&lt;br&gt;ID 264/265 là thành viên hợp lệ không có polygon; -1 = thiếu mã / ngoài phạm vi&lt;br&gt;PK = khóa chính · FK = khóa ngoại · BK = khóa nghiệp vụ · DD = degenerate dimension" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="760" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
